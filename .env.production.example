# Copy to the VPS as .env.production and replace every placeholder.
# CLIENT_ORIGIN is the complete HTTPS origin, without a trailing slash.
CLIENT_ORIGIN=https://carwash.carcareku.tech
WEB_PORT=16200

MYSQL_DATABASE=carwash_queue
MYSQL_USER=carwash_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
BOOKING_SLOT_CAPACITY=1
PROMPTPAY_NUMBER=
SLIP2GO_SECRET=
SLIP2GO_RECEIVER_ACCOUNT_TYPE=02001
SLIP2GO_RECEIVER_ACCOUNT_NUMBER=
