# This app uses a separate subdomain, leaving the existing site on the root domain untouched.
# Install as a separate Nginx site so the existing project's config is untouched.
server {
    listen 80;
    server_name carwash.carcareku.tech;

    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:16200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
